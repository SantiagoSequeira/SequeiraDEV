        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>HU__c.External_Reference__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <classAccesses>
        <apexClass>HuController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <tabSettings>
        <tab>HU__c</tab>
        <visibility>Visible</visibility>
