        <field>HU__c.Test_Text__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>HU__c.Permission_Requests__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>HU__c.Has_Data__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>HU__c.Has_Permissions__c</field>
        <readable>true</readable>
        <editable>true</editable>
